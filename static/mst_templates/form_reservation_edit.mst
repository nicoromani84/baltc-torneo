<form action="">
	<div class="form-group xs-fullwidth">
		<div class="input-group">
			<div class="input-group-prepend"><span class="input-group-text"><i class="icon far fa-calendar"></i></span></div>
			<input type="date" name="date" id="fecha" autocomplete="off" value="{{selectedDate}}" placeholder="Seleccione día" class="form-control" readonly>
		</div>
	</div>
	<div class="form-group xs-fullwidth">
		<div class="input-group">
			<div class="input-group-prepend"><span class="input-group-text"><i class="far fa-clock"></i></span></div>
			<input type="hidden" name="hour" id="hora" value="{{ selectedTurn }}"><span>{{ selectedTurn }}</span>
		</div>
	</div>
	<div class="form-group xs-fullwidth">
		<div class="input-group">
			<div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-thumbtack"></i></span></div>
			<input type="hidden" name="court" id="cancha" value="{{ selectedCourt.id }}"><span>{{ selectedCourt.name }}</span>
		</div>
	</div>
	<div class="form-group xs-fullwidth">
		<div class="input-group">
			<div class="input-group-prepend"><span class="input-group-text" style="font-size:13px">VS</span></div>
			<input type="search" autocomplete="off" placeholder="Seleccione los participantes" class="typeahead form-control">
		</div>
	</div>
	<div class="partners"></div>
	<div class="form-group xs-fullwidth">
		<div class="input-group">
			<div class="input-group-prepend"><span class="input-group-text"><i class="flaticon-squash-rackets"></i></span></div>
			<select name="type" id="type" required class="mr3 form-control">
				<option value="Singles"{{#isSingles}} selected{{/isSingles}}>Singles</option>
				<option value="Doubles"{{#isDoubles}} selected{{/isDoubles}}>Doubles</option>
			</select>
		</div>
	</div>
	
	<div class="form-group to-right">
		<button type="submit" class="btn btn-primary"><span>Actualizar</span></button>
	</div>
</form>